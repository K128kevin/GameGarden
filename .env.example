# ---- Required ---------------------------------------------------------------
# Postgres connection string (Neon / Supabase free tier). Use the *pooled* URL on Vercel.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Public URL of the app (no trailing slash). On Vercel this can be your production domain.
BETTER_AUTH_URL=http://localhost:3000
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Encrypts stored platform tokens/app passwords. `openssl rand -base64 32`. Don't change it after connecting accounts.
ENCRYPTION_KEY=
# Protects /api/cron/tick. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# Google OAuth (sign-in, and YouTube connection unless YOUTUBE_* is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key for the growth strategist
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5), e.g. claude-sonnet-5 to cut cost
# ANTHROPIC_MODEL=

# Comma-separated list of Google emails allowed to sign up. Remove to open sign-ups to anyone.
ALLOWED_EMAILS=you@gmail.com

# ---- Platforms (optional; Bluesky needs no server config) --------------------
# Reddit "web app" from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:gamegarden:v0.1 (by /u/yourusername)

# Use a separate Google OAuth client for YouTube (optional; defaults to GOOGLE_*)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
